{
  "name": "itsmnthn-github-io",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "resume:pdf": "node scripts/resume-pdf.mjs",
    "meta:images": "node scripts/meta-images.mjs",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "rm -rf .output .nuxt .data .cache dist",
    "cleanup": "pnpm run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@nuxt/content": "catalog:modules",
    "@nuxt/fonts": "catalog:modules",
    "@nuxt/hints": "catalog:modules",
    "@nuxt/icon": "catalog:modules",
    "@nuxt/image": "catalog:modules",
    "@nuxt/scripts": "catalog:modules",
    "@nuxtjs/seo": "catalog:modules",
    "nuxt": "catalog:nuxt"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:icons",
    "@iconify-json/mdi": "catalog:icons",
    "@iconify-json/simple-icons": "catalog:icons",
    "@iconify-json/streamline-freehand": "catalog:icons",
    "@tailwindcss/vite": "catalog:styles",
    "@takumi-rs/core": "catalog:modules",
    "better-sqlite3": "catalog:nuxt",
    "chokidar": "catalog:external",
    "lru-cache": "catalog:external",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "remark-emoji": "catalog:external",
    "tailwindcss": "catalog:styles",
    "typescript": "catalog:tooling"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.15.0"
}